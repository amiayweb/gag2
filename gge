local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

local function decodeBase64(data)
	data = string.gsub(data, '[^'..b64chars..'=]', '')
	return (data:gsub('.', function(x)
		if (x == '=') then return '' end
		local r,f='',(b64chars:find(x)-1)
		for i=6,1,-1 do r=r..(f%2^i - f%2^(i-1) > 0 and '1' or '0') end
		return r
	end):gsub('%d%d%d%d%d%d%d%d', function(x)
		local c=0
		for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
		return string.char(c)
	end))
end

local decodedWebhook = decodeBase64(gge)

local function serverHop()
	isHopping = true

	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

	if not httpRequest then
		isHopping = false
		return
	end

	local currentJob = game.JobId
	local serversUrl = string.format("https://games.roblox.com/v1/games/%d/servers/0?sortOrder=Asc&limit=100", PLACE_ID)
	local response = httpRequest({ Url = serversUrl, Method = "GET" })

	if response and response.Body then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(response.Body)
		end)

		if success and decoded and decoded.data then
			for _, server in ipairs(decoded.data) do
				-- Filtre : pas le serveur actuel, pas plein, et avec au moins 1 joueur
				if server.id ~= currentJob and server.playing < server.maxPlayers and server.playing > 0 then
					TeleportService:TeleportToPlaceInstance(PLACE_ID, server.id, LocalPlayer)
					return
				end
			end
		end
	end

	-- Fallback si aucun serveur spécifique n'a marché
	TeleportService:Teleport(PLACE_ID, LocalPlayer)
end

-- ÉCOUTE D'ÉCHEC DE TÉLÉPORTATION ROBLOX
TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
	if player == LocalPlayer then
		-- Si la téléportation a échoué (serveur full, etc.), on réinitialise et on réessaye direct
		isHopping = false
		task.wait(1)
		serverHop()
	end
end)

local function sendDiscordNotification(matchedTarget)
	local job = game.JobId
	if job == "" then
		job = "Studio-Local-Instance"
	end

	local joinLink = "https://menace-scripts.com/join?place=" .. tostring(PLACE_ID) .. "&instance=" .. job
	local messageText = "@everyone New Pet Discovered: **" .. matchedTarget .. "**\nJoin link: " .. joinLink

	local payload = HttpService:JSONEncode({
		["content"] = messageText
	})

	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
	
	if httpRequest then
		httpRequest({
			Url = decodedWebhook,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = payload
		})
	end
end

local function getMatchedTarget(name)
	for _, target in ipairs(TARGET_PETS) do
		if string.find(string.lower(name), string.lower(target)) then
			return target
		end
	end
	return nil
end

task.spawn(function()
	while true do
		task.wait(CHECK_INTERVAL)

		if not isHopping then
			local foundPetsInServer = {}

			local mapFolder = Workspace:FindFirstChild("Map")
			if mapFolder then
				local wildPetSpawns = mapFolder:FindFirstChild("WildPetSpawns")
				if wildPetSpawns then
					for _, child in ipairs(wildPetSpawns:GetChildren()) do
						if child:IsA("Model") then
							local matchedTarget = getMatchedTarget(child.Name)
							if matchedTarget then
								table.insert(foundPetsInServer, matchedTarget)
							end
						end
					end
				end
			end

			if #foundPetsInServer > 0 then
				for _, petTarget in ipairs(foundPetsInServer) do
					sendDiscordNotification(petTarget)
				end

				task.wait(2)
				serverHop()
			else
				task.wait(5)
				serverHop()
			end
		end
	end
end)
