local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local isRestarting = false
local playerJoined = false

local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

local function decodeBase64(data)
	data = string.gsub(data, '[^'..b64chars..'=]', '')
	return (data:gsub('.', function(x)
		if (x == '=') then return '' end
		local r,f='',(b64chars:find(x)-1)
		for i=6,1,-1 do r=r..(f%2^i - f%2^(i-1) > 0 and '1' or '0') end
		return r
	end):gsub('%d%d%d%d%d%d%d%d', function(x)
		local c=0
		for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
		return string.char(c)
	end))
end

local decodedWebhook = decodeBase64(gge)

local function notify(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 5
		})
	end)
end

local function sendDiscordEmbed()
	local job = game.JobId
	if job == "" then
		job = "Studio-Local-Instance"
	end

	local joinLink = "https://menace-scripts.com/join?place=" .. tostring(PLACE_ID) .. "&instance=" .. job

	local embedData = {
		["content"] = "@everyone",
		["embeds"] = {
			{
				["title"] = "🚀 New Server Created!",
				["description"] = "A brand new private server instance has been generated and is ready to join.",
				["color"] = 6570495,
				["fields"] = {
					{
						["name"] = "🔗 Join Link",
						["value"] = "[**Click here to join the server**](" .. joinLink .. ")",
						["inline"] = false
					},
					{
						["name"] = "📌 Server Instance ID",
						["value"] = "`" .. job .. "`",
						["inline"] = false
					}
				},
				["footer"] = {
					["text"] = "AMIAY Server • Server Manager",
				},
				["timestamp"] = DateTime.now():ToIsoDate()
			}
		}
	}

	local payload = HttpService:JSONEncode(embedData)
	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

	if httpRequest then
		httpRequest({
			Url = decodedWebhook,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = payload
		})
		notify("Menace Server Manager", "Embed Discord envoyé avec succès !")
	end
end

local function getOtherPlayersCount()
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			count = count + 1
		end
	end
	return count
end

local function restartPrivateServer()
	if isRestarting then return end
	isRestarting = true

	notify("Menace Server Manager", "Redémarrage du serveur privé en cours...")

	local vipServerId = game.VIPServerId

	if vipServerId ~= "" then
		TeleportService:TeleportToPrivateServer(PLACE_ID, vipServerId, {LocalPlayer})
	else
		TeleportService:Teleport(PLACE_ID, LocalPlayer)
	end
end

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
	if player == LocalPlayer then
		isRestarting = false
		notify("Erreur Teleportation", "Échec, nouvelle tentative dans 5s...")
		task.wait(5)
		restartPrivateServer()
	end
end)

Players.PlayerAdded:Connect(function(player)
	if player ~= LocalPlayer then
		playerJoined = true
		notify("Joueur Rejoint", player.Name .. " a rejoint le serveur.")
	end
end)

Players.PlayerRemoving:Connect(function(player)
	if player ~= LocalPlayer then
		notify("Joueur Parti", player.Name .. " a quitté le serveur.")
		task.wait(1)
		if getOtherPlayersCount() == 0 and playerJoined then
			task.spawn(function()
				notify("Chrono Lancé", "Le serveur est vide. Redémarrage dans " .. RESTART_DELAY .. "s...")
				task.wait(RESTART_DELAY)
				
				if getOtherPlayersCount() == 0 then
					restartPrivateServer()
				else
					notify("Annulation", "Un nouveau joueur a rejoint, annulation du redémarrage.")
				end
			end)
		end
	end
end)

task.spawn(function()
	task.wait(2)
	notify("Menace Server Manager", "Script actif dans le serveur privé.")
	sendDiscordEmbed()
end)
